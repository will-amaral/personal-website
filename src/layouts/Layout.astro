---
import { ClientRouter } from 'astro:transitions'

import '@/styles/normalize.css'
import '@/styles/barebones.css'
import Link from '@/components/Link.astro'
import ThemeSwitcher from '@/components/ThemeSwitcher.astro'

const {
  pageTitle,
  description = 'Will Amaral, Lead Engineer at Thoughtworks. Product engineering, architecture, technical leadership and writing.',
  lang = 'en',
} = Astro.props
---

<!doctype html>
<html lang={lang} transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle} | Will Amaral</title>
    <meta name="description" content={description} />
    <meta name="author" content="Will Amaral" />
    <link rel="canonical" href={new URL(Astro.url.pathname === '/blog' ? '/writing' : Astro.url.pathname, 'https://will.amaral.dev')} />
    <ClientRouter />
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <Link href="/">Home</Link>
        <Link href="/work">Work</Link>
        <Link href="/speaking">Speaking</Link>
        <Link href="/writing">Writing</Link>
      </nav>
      <ThemeSwitcher />
    </header>
    <main transition:animate="slide">
      <slot />
    </main>
    <footer class="grid-container full">
      <p>Copyright © {new Date().getFullYear()} Willian Amaral</p>
    </footer>
  </body>
</html>

<style>
  header {
    max-width: var(--container-max-width);
    margin: 4% auto;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  nav {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  main {
    max-width: var(--container-max-width);
    margin: auto;
    min-height: 60vh;
    padding-bottom: 3rem;
  }

  footer {
    margin-top: 20px;
  }

  footer > p {
    font-size: 1.5rem;
  }
</style>

<style is:global>
  main h1 { font-weight: 500; }
  main h2 { font-size: 2.8rem; margin-top: 4rem; }
  main h3 { font-size: 2.2rem; font-weight: 500; letter-spacing: 0; margin-bottom: 1rem; }
  main section { margin-top: 3rem; }
  main .meta { color: var(--text-color-softer); font-size: 1.6rem; }
  a:focus-visible { outline: 2px solid var(--accent-color); outline-offset: 5px; }
  @media (max-width: 599px) { header { gap: 2rem; } }
</style>
